# ==============================================================================
# GridBricks Wind Forecast Decision Portal — Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Port for Uvicorn server (default: 8000)
PORT=8000

# Directory containing cached Elexon JSON datasets (raw_fuelhh_cached.json, raw_windfor_cached.json)
# Container default: /app/data | Local default: backend/data
DATA_DIR=/app/data

# Allowed frontend origins for CORS (comma-separated, no wildcards when credentials enabled)
# Production deployment: https://gridbricks-frontend.onrender.com
# Local development default: http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://127.0.0.1:80,http://localhost,http://127.0.0.1
CORS_ORIGINS=https://gridbricks-frontend.onrender.com,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
# Base URL for backend API requests.
# - Production with Docker Compose / Nginx reverse proxy: leave as /api
# - Two-tier deployment (e.g. Render separate services): set to https://<backend-domain>/api
VITE_API_BASE_URL=/api
